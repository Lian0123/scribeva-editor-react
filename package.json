{
  "name": "scribeva-editor-react",
  "version": "0.0.4",
  "description": "Official React bindings for the Scribeva enterprise HTML editor.",
  "keywords": [
    "react",
    "html-editor",
    "rich-text-editor",
    "wysiwyg",
    "typescript",
    "scribeva"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/scribeva-react.cjs",
  "module": "./dist/scribeva-react.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/scribeva-react.js",
      "require": "./dist/scribeva-react.cjs"
    },
    "./styles.css": "./dist/scribeva-react.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts && node scripts/prepare-demo.mjs",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test:coverage && npm run build && npm run build:demo",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "scribeva-editor": ">=0.0.4 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scribeva-editor": "^0.0.4",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lian0123/scribeva-editor-react.git"
  },
  "homepage": "https://github.com/Lian0123/scribeva-editor-react#readme",
  "bugs": {
    "url": "https://github.com/Lian0123/scribeva-editor-react/issues"
  }
}
